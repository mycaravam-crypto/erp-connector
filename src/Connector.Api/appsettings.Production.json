{
  "Auth": {
    // REQUIRED — set via environment variable: Auth__JwtSecret=<value>
    // Minimum 32 characters, randomly generated. Example:
    //   openssl rand -base64 48
    "JwtSecret": "REPLACE_WITH_SECURE_SECRET_MINIMUM_32_CHARS",
    "JwtExpiryHours": 8,
    // Add one object per operator. Generate BCrypt hashes with the dev endpoint:
    //   POST /api/auth/hash  { "password": "plaintext" }
    // or with: htpasswd -bnBC 11 "" mypassword | tr -d ':\n'
    "Users": [
      { "Username": "alice", "PasswordHash": "$2a$11$REPLACE_WITH_BCRYPT_HASH_FOR_ALICE" },
      { "Username": "bob",   "PasswordHash": "$2a$11$REPLACE_WITH_BCRYPT_HASH_FOR_BOB"   }
    ],
    // Machine-to-machine credentials for POST /api/pipeline/run/{presetName} (external systems pulling a
    // saved Step-3 preset without interactive login). Generate a random key, e.g. openssl rand -hex 32,
    // then store only its SHA-256 hash here — never the raw key:
    //   printf '%s' '<raw key>' | sha256sum
    "ApiKeys": [
      { "Name": "erp-bot", "KeyHash": "REPLACE_WITH_SHA256_HEX_OF_THE_RAW_KEY" }
    ]
  },
  // Comma-separated list of allowed origins for the browser client.
  // Set to the URL where the Vue UI is served, e.g. https://connector.internal
  "AllowedOrigins": [],
  // Restrict to your actual hostname in production, e.g. "connector.internal"
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // Absolute paths to the SQLite database files on the host / container volume.
    "ExportLog": "Data Source=/data/db/export_log.db"
  },
  "ExportSink": {
    // Absolute path to the staging directory where export packages are written.
    // Must be writable by the process user. Use a dedicated volume in Docker.
    "StagingPath": "/data/staging"
  },
  "ExportWorker": {
    // Daily export time in UTC (HH:mm). Default 06:00.
    "ScheduledTimeUtc": "06:00",
    // How many days to retain export files and log records before cleanup.
    // Adjust after legal/DPO sign-off (Open Point #7).
    "RetentionDays": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
