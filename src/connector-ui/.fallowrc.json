{
  // This file is JSONC: fallow reads these comments; generic JSON tools may not.
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "src/index.{ts,tsx,js,jsx}",
    "src/main.{ts,tsx,js,jsx}"
  ],
  "duplicates": {
    // Hide pair-only clones; focus on widespread copy-paste
    // worth refactoring. Lower to 2 to report every duplicate pair.
    "minOccurrences": 3
    // Common additions (uncomment to enable):
    // "ignore": [
    //   "**/lib/**",          // for repos that publish transpiled output to lib/
    //   "**/legacy/**",       // for repos with legacy-build artifacts
    //   "**/__generated__/**", // Relay, GraphQL Code Generator
    //   "**/generated/**"     // OpenAPI, Protobuf codegen
    // ]
  },
  "rules": {
    "unused-dependencies": "warn"
  },
  "health": {
    "thresholdOverrides": [
      {
        "files": [
          "src/components/ExportNodeTreeEditor.vue",
          "src/components/ExportDefinitionRunControls.vue",
          "src/views/ExportDefinitionEditView.vue",
          "src/views/ExportDefinitionsView.vue",
          "src/components/StatusBadge.vue"
        ],
        "maxCognitive": 35,
        "maxCrap": 85,
        "reason": "Export Definitions tree-builder UI. ExportNodeTreeEditor.vue is a self-referencing recursive editor (see its own comment; same shape as NestedGroupEditor.vue); the view/control components orchestrate several related actions each with small, independent state, which isn't worth trading for several tiny files with no shared logic to extract. See knowledge/planning/code-health-backlog.md."
      },
      {
        "files": ["src/views/SchemaView.vue"],
        "maxCognitive": 35,
        "maxCrap": 85,
        "reason": "Known, reviewed complexity of the legacy mapping editor (see knowledge/planning/code-health-backlog.md)."
      },
      {
        "files": [
          "src/components/ImportNodeTreeEditor.vue",
          "src/components/ImportRunReviewDialog.vue",
          "src/views/ImportDefinitionEditView.vue",
          "src/views/ImportDefinitionsView.vue"
        ],
        "maxCognitive": 35,
        "maxCrap": 85,
        "reason": "Import Definitions frontend — the write-side mirror of the Export Definitions override above, same rationale and near-identical numbers. ImportNodeTreeEditor.vue is the same self-referencing recursive editor shape as ExportNodeTreeEditor.vue; ImportRunReviewDialog.vue has its count-summary and terminal-state blocks extracted into ImportRunCountSummary.vue/ImportRunOutcome.vue but keeps its own loading/error/pending-review/terminal branching, which is inherent to one dialog covering both an interactive review and a read-only outcome view."
      },
      {
        "files": ["src/components/PresetsToolbar.vue"],
        "maxCognitive": 15,
        "maxCrap": 35,
        "reason": "Template complexity (10 cyclomatic/11 cognitive/31.6 CRAP) of the presets toolbar's several small, related actions."
      },
      {
        "files": ["src/components/ImportDefinitionPreviewPanel.vue"],
        "maxCognitive": 15,
        "maxCrap": 45,
        "reason": "A file picker plus two related, independently-disabled actions (Preview and Run) sharing the same sample-JSON state — the same 'small related actions in one panel' shape the tree-editor overrides above accept rather than splitting into files with no real shared logic to extract."
      }
    ]
  }
}
